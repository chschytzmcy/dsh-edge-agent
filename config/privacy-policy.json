{
  "version": "1.5.0",
  "_comment": "sanitizationRules 的 pattern 必须与 src/dsh-adapter/pii-utils.ts 的 PII_PATTERNS 保持一致（tests/unit/pii-utils.test.ts 有一致性断言）。已移除 replacement 字段：占位符由 sanitizer-pipeline 自行生成为 [<PIITYPE>_<seq>]，该字段历史上不生效。",
  "routingRules": [
    {
      "pattern": "(导出|删除|清空|格式化).*(数据库|系统|磁盘|全部数据)",
      "realm": "REJECT",
      "confidence": 0.9,
      "rationale": "Dangerous system operation"
    },
    {
      "pattern": "(drop\\s+table|rm\\s+-rf|format\\s+[a-z]:|del\\s+/[fs])",
      "realm": "REJECT",
      "confidence": 0.95,
      "rationale": "Destructive command pattern"
    },
    {
      "pattern": "(本地|local|文件|file|计算|calculate|读取|写入)",
      "realm": "LOCAL",
      "confidence": 0.8,
      "rationale": "Local operations stay on device"
    },
    {
      "pattern": "(密码|password|secret|密钥|private.?key|token)",
      "realm": "LOCAL",
      "confidence": 0.9,
      "rationale": "Sensitive credentials must not leave device"
    },
    {
      "pattern": "(身份证号|id.?card|银行卡|bank.?card|信用卡|credit.?card)",
      "realm": "LOCAL",
      "confidence": 0.95,
      "rationale": "Financial/identity PII must stay local"
    },
    {
      "pattern": "(手机号|电话号码|手机.{0,5}号|phone.?number|mobile.?number)",
      "realm": "LOCAL",
      "confidence": 0.95,
      "rationale": "Phone PII must stay local"
    },
    {
      "pattern": "(邮箱|电邮|email.?address|e-?mail)",
      "realm": "LOCAL",
      "confidence": 0.95,
      "rationale": "Email PII must stay local"
    },
    {
      "pattern": "(IP\\s*地址|服务器.{0,8}(IP|地址)|server\\s+IP|局域网.{0,8}(IP|地址))",
      "realm": "LOCAL",
      "confidence": 0.9,
      "rationale": "IP address PII must stay local"
    },
    {
      "pattern": "(家庭住址|住址|home\\s+address|通信地址)",
      "realm": "LOCAL",
      "confidence": 0.85,
      "rationale": "Home address PII must stay local"
    },
    {
      "pattern": "(翻译|translate|summarize|summary|explain|为什么|what is|how to)",
      "realm": "CLOUD",
      "confidence": 0.7,
      "rationale": "Knowledge/translation tasks can use cloud LLM"
    }
  ],
  "sanitizationRules": [
    {
      "pattern": "\\b[1-9]\\d{5}(?:19|20)\\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]\\b",
      "dataClass": "secret",
      "piiType": "id-card"
    },
    {
      "pattern": "\\b\\d{16,19}\\b",
      "dataClass": "secret",
      "piiType": "bank-card"
    },
    {
      "pattern": "\\b1[3-9]\\d{9}\\b",
      "dataClass": "confidential",
      "piiType": "phone"
    },
    {
      "pattern": "[\\w.-]+@[\\w.-]+\\.\\w+",
      "dataClass": "confidential",
      "piiType": "email"
    },
    {
      "pattern": "(?:sk-(?:proj-|ant-|live-|test-|org-)?[a-zA-Z0-9]{20,}|key-[a-zA-Z0-9]{16,}|api[_-]?key[_-]?[a-zA-Z0-9]{16,})",
      "dataClass": "secret",
      "piiType": "api-key"
    },
    {
      "pattern": "(?<![vV\\d.])(?:(?:25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1\\d{2}|[1-9]?\\d)(?!\\.?\\d)",
      "dataClass": "confidential",
      "piiType": "ip-address"
    },
    {
      "pattern": "(?:[0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}",
      "dataClass": "confidential",
      "piiType": "mac-address"
    },
    {
      "pattern": "\\b(?:E[0-9A-Z]\\d{7}|G\\d{8})\\b",
      "dataClass": "secret",
      "piiType": "passport"
    },
    {
      "pattern": "[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤川青藏琼][A-Z][A-HJ-NP-Z0-9]{5}",
      "dataClass": "confidential",
      "piiType": "license-plate"
    }
  ],
  "dataClassifications": [
    {
      "class": "public",
      "defaultRealm": "CLOUD",
      "ttlSeconds": 3600
    },
    {
      "class": "internal",
      "defaultRealm": "SANITIZED",
      "ttlSeconds": 1800
    },
    {
      "class": "confidential",
      "defaultRealm": "LOCAL",
      "ttlSeconds": 900
    },
    {
      "class": "secret",
      "defaultRealm": "LOCAL",
      "ttlSeconds": 300
    }
  ],
  "globalConstraints": {
    "maxCloudRequestsPerMinute": 20,
    "requireAttestation": false,
    "blockIfTcbCompromised": true
  }
}
