    "cordis.yml",
    "presets",
    "!config/edge.json"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "clean": "node scripts/clean-lib.mjs",
    "compile": "node scripts/clean-lib.mjs && tsc -p tsconfig.json",
    "prepare": "node scripts/run.mjs compile",
    "build:client": "node scripts/build-client.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "build:installable": "node scripts/rebuild-installable.mjs",
    "build:pack": "node scripts/_pack-core.mjs all",
    "build:windows": "bash scripts/build-windows.sh",
    "build:macos": "bash scripts/build-macos.sh",
    "build:linux": "bash scripts/build-linux.sh",
    "build": "node scripts/run.mjs compile typecheck:client build:client build:installable verify:build",
    "lint": "eslint src tests/unit scripts",
    "test": "vitest run tests/unit",
    "e2e:coverage": "bash scripts/e2e-ops-log-coverage.sh",
    "e2e:benchmark": "bash scripts/e2e-model-quality-bench.sh",
    "verify:build": "node scripts/run.mjs verify:boundary verify:contract verify:patch-surface verify:patch-row-shape verify:plugin-spec verify:env-bridge verify:bundle-mount verify:installable verify:installable-edge verify:host-mount verify:client-mount",
    "verify:boundary": "node --import tsx/esm scripts/verify-adapter-boundary.ts",
    "verify:contract": "node --import tsx/esm scripts/verify-upstream-contract.ts",
    "verify:patch-surface": "node --import tsx/esm scripts/verify-patch-surface.ts",
    "verify:patch-row-shape": "node scripts/verify-patch-row-shape.mjs",
    "verify:plugin-spec": "node --import tsx/esm scripts/verify-plugin-spec.ts",
    "verify:env-bridge": "node scripts/verify-env-bridge.mjs",
    "verify:bundle-mount": "node scripts/verify-bundle-mounted.mjs",
    "verify:installable": "node scripts/verify-installable.mjs",
    "verify:installable-edge": "node scripts/_verify-installable-edge.mjs",
    "verify:host-mount": "node scripts/_simulate-host-mount.mjs",
    "verify:client-mount": "node scripts/_simulate-client-mount.mjs",
    "verify:package": "npm pack --dry-run --json --ignore-scripts | node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
