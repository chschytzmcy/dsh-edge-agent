{
  "version": "1.2.0",
  "routingRules": [
    {
      "pattern": "(导出|删除|清空|格式化).*(数据库|系统|磁盘|全部数据)",
      "realm": "REJECT",
      "confidence": 0.9,
      "rationale": "Dangerous system operation"
    },
    {
      "pattern": "(drop\\s+table|rm\\s+-rf|format\\s+[a-z]:|del\\s+/[fs])",
      "realm": "REJECT",
      "confidence": 0.95,
      "rationale": "Destructive command pattern"
    },
    {
      "pattern": "(本地|local|文件|file|计算|calculate|读取|写入)",
      "realm": "LOCAL",
      "confidence": 0.8,
      "rationale": "Local operations stay on device"
    },
    {
      "pattern": "(密码|password|secret|密钥|private.?key|token)",
      "realm": "LOCAL",
      "confidence": 0.9,
      "rationale": "Sensitive credentials must not leave device"
    },
    {
      "pattern": "(身份证号|id.?card|银行卡|bank.?card|信用卡|credit.?card)",
      "realm": "LOCAL",
      "confidence": 0.95,
      "rationale": "Financial/identity PII must stay local"
    },
    {
      "pattern": "(翻译|translate|summarize|summary|explain|为什么|what is|how to)",
      "realm": "CLOUD",
      "confidence": 0.7,
      "rationale": "Knowledge/translation tasks can use cloud LLM"
    }
  ],
  "sanitizationRules": [
    {
      "pattern": "1[3-9]\\d{9}",
      "replacement": "[PHONE]",
      "dataClass": "confidential",
      "piiType": "phone"
    },
    {
      "pattern": "[1-9]\\d{5}(19|20)\\d{2}(0[1-9]|1[0-2])(0[1-9]|[12]\\d|3[01])\\d{3}[\\dXx]",
      "replacement": "[ID_CARD]",
      "dataClass": "secret",
      "piiType": "id-card"
    },
    {
      "pattern": "\\d{16,19}",
      "replacement": "[BANK_CARD]",
      "dataClass": "secret",
      "piiType": "bank-card"
    },
    {
      "pattern": "[\\w.-]+@[\\w.-]+\\.\\w+",
      "replacement": "[EMAIL]",
      "dataClass": "confidential",
      "piiType": "email"
    },
    {
      "pattern": "(sk-[a-zA-Z0-9]{20,}|key-[a-zA-Z0-9]{16,}|api[_-]?key[_-]?[a-zA-Z0-9]{16,})",
      "replacement": "[API_KEY]",
      "dataClass": "secret",
      "piiType": "api-key"
    },
    {
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "replacement": "[IP_ADDRESS]",
      "dataClass": "confidential",
      "piiType": "ip-address"
    },
    {
      "pattern": "([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}",
      "replacement": "[MAC_ADDRESS]",
      "dataClass": "confidential",
      "piiType": "mac-address"
    },
    {
      "pattern": "(E[0-9A-Z]\\d{7}|G\\d{8})",
      "replacement": "[PASSPORT]",
      "dataClass": "secret",
      "piiType": "passport"
    },
    {
      "pattern": "[京津沪渝冀豫云辽黑湘皖鲁新苏浙赣鄂桂甘晋蒙陕吉闽贵粤川青藏琼][A-Z][A-HJ-NP-Z0-9]{5}",
      "replacement": "[LICENSE_PLATE]",
      "dataClass": "confidential",
      "piiType": "license-plate"
    }
  ],
  "dataClassifications": [
    { "class": "public", "defaultRealm": "CLOUD", "ttlSeconds": 3600 },
    { "class": "internal", "defaultRealm": "SANITIZED", "ttlSeconds": 1800 },
    { "class": "confidential", "defaultRealm": "LOCAL", "ttlSeconds": 900 },
    { "class": "secret", "defaultRealm": "LOCAL", "ttlSeconds": 300 }
  ],
  "globalConstraints": {
    "maxCloudRequestsPerMinute": 20,
    "requireAttestation": false,
    "blockIfTcbCompromised": true
  }
}
