# dsh-edge-agent 配置文件模板
# ============================
# 使用方法:
#   1. 复制本文件:  cp .env.example .env
#   2. 填写真实值:  编辑 .env  (此文件已加入 .gitignore, 不会提交)
#   3. 启动 DSH:    node --env-file=.env $(which dsh) --profile dsh-edge-agent
#                  或: export $(grep -v '^#' .env | xargs) && dsh --profile dsh-edge-agent
#
# Node ≥ 20.6 原生支持 --env-file，无需 dotenv 依赖。
# ──────────────────────────────────────────────────────────────────────

# HTTP API 鉴权密钥（Bearer Token）。留空则跳过认证（仅开发用）。
EDGE_API_KEY=test-secret-key

# HTTP API 监听端口
DSH_EDGE_HTTP_PORT=21017

# ── Provider 选择（影响 system prompt 文本，不影响实际路由） ────────────
# 实际路由由 http-api.handleChat() 根据意图分类结果决定。
DSH_EDGE_PROVIDER=cloud-deepseek-v4
DSH_EDGE_MODEL=deepseek-chat

# ── 本地 LLM（真实模式） ────────────────────────────────────────────────
# mock:   进程内回显 [LOCAL-MOCK] ...（默认，无需外部服务）
# real:   POST 到 OpenAI 兼容端点（如 llama.cpp / vLLM / Ollama）
DSH_EDGE_LOCAL_LLM_MODE=real
DSH_EDGE_LOCAL_LLM_BASEURL=http://192.168.66.195:8701/v1
DSH_EDGE_LOCAL_LLM_MODEL=qwen3-4b-instruct-2507
# 可选：本地 LLM 鉴权密钥环境变量名（端点需要时设置）
# DSH_EDGE_LOCAL_LLM_KEY_ENV=

# ── 云端 LLM（DeepSeek） ────────────────────────────────────────────────
# 用于 CLOUD intent 路由。必须填写真实 API Key。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx