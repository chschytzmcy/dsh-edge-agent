# dsh-edge-agent 配置文件模板
# ============================
# 使用方法:
#   1. 复制本文件:  cp .env.example .env
#   2. 填写真实值:  编辑 .env  (此文件已加入 .gitignore, 不会提交)
#   3. 启动 DSH:    source .env.sh  (从 .env 读取并 export)
#                  或: 见 README "部署" 章节
#
# ============================================================
# 配置架构（2026-09-17 "统一下 + 明确下"；2026-10-18 §7.100 收敛）
# ============================================================
# §1: LOCAL 池 —— **唯一必配**。CLOUD 池可选：不配时 cloud-llm 路由
#     DELEGATE 到宿主 profile 已配置的模型提供商（桌面 GUI 选的模型 /
#     dsh-base 默认 deepseek-official）；配了才走自研直连。
# §2: 2 个 stage 指针（GUARD / INTENT）—— 可选；空 = Schema 默认 local-llm。
#     隐私不变式（用户仲裁 2026-10-18）：分类/guard 检测只吃本地模型，
#     LOCAL 池没配/不可达 = 自动降级关键词/规则档，绝不借用宿主云模型。
# §3: 其他非 LLM 配置
#
# ★ 主对话 LLM 路由：由**意图分类结果**决定（不存在 MAIN_PROVIDER
#   等"主 LLM 选择"变量）：
#     intent=LOCAL      → local-llm / LOCAL_LLM_MODEL
#     intent=CLOUD      → cloud-llm / CLOUD_LLM_MODEL 或未配时 delegate
#     intent=SANITIZED  → sanitize 后同上
#     intent=REJECT     → 4xx 拒
#
# 全图速览（§7.100 推荐形态：只配 LOCAL）：
#
#   ┌────────────────────┬─────────────────┬──────────────────────────────────┐
#   │ 决策点 / Stage     │ 池              │ model                            │
#   ├────────────────────┼─────────────────┼──────────────────────────────────┤
#   │ prompt-guard       │ LOCAL (local)   │ LOCAL_LLM_MODEL（没配→正则档）  │
#   │ 意图路由 (INTENT)  │ LOCAL (local)   │ LOCAL_LLM_MODEL（没配→规则档）  │
#   │ agent-loop 兜底    │ 宿主选择        │ 桌面 GUI / dsh-base 默认         │
#   │ input-guard 降级   │ LOCAL (local)   │ 派生自 LOCAL_LLM_MODEL           │
#   ├────────────────────┼─────────────────┼──────────────────────────────────┤
#   │ 主对话（由 intent  │ LOCAL → LOCAL   │ LOCAL_LLM_MODEL                  │
#   │ 分类结果决定）     │ CLOUD → DELEGATE│ 宿主 profile 提供商（脱敏后出网）│
#   └────────────────────┴─────────────────┴──────────────────────────────────┘
#
# 切换任何 stage 的池 → 改对应 *_PROVIDER 一行（cloud-llm ↔ local-llm）
# 切换池里的 model → 改对应 CLOUD_LLM_MODEL / LOCAL_LLM_MODEL 一行
# 主对话 LLM 不靠环境变量配置——由运行时意图分类结果决定
# ──────────────────────────────────────────────────────────────

# ── Secret: API keys ────────────────────────────────────────────────
EDGE_API_KEY=test-secret-key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── HTTP API 入口 ───────────────────────────────────────────────────
HTTP_HOST=127.0.0.1
HTTP_PORT=21017

# ============================================================
# §1. LLM 池 —— LOCAL 必配；CLOUD 可选（§7.100）
# ============================================================

# ── ☁️  CLOUD LLM 池（cloud-llm-adapter 装载）—— §7.100 起 **可选** ──
# 默认形态：**整段不配**。cloud-llm 路由进入 DELEGATE 模式：每次云调用
# 转发到宿主 profile 已配置的模型提供商——
#   1) CLOUD_DELEGATE_PROVIDER 显式指定（可选 override）
#   2) 宿主 agentDefaultModel 当前选择（桌面 GUI 模型选择器，实时生效）
#   3) 活的宿主云路由探针（deepseek-account / deepseek-official 优先，
#      其余 llm-pi-ai 用户路由按注册序）
# key / OAuth / 凭据解析全归宿主 adapter，edge 侧不碰任何 secret。
# 三条都没有 → 显式报错（http-api 502 / SSE error 帧），不再静默空回复。
#
# CLOUD_DELEGATE_PROVIDER=qwen-token-plan-cn   # 锁定委托目标（默认自动）
# CLOUD_DELEGATE_MODEL=qwen3.8-flash           # wire model override
# CLOUD_DELEGATE=false                         # LOCAL-only 部署禁用委托：
#   #   云不可用 → input-guard 恢复 §7.35 降级 LOCAL 语义
#
# 只有当你要 edge **自有直连**云池（独立部署/宿主没有任何提供商/要用非
# 宿主供应商）时才配下面三件套——§7.83 起的对称 key-slot 语义不变：
# CLOUD_LLM_BASEURL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# CLOUD_LLM_KEY_ENV=DASHSCOPE_API_KEY
# CLOUD_LLM_MODEL=qwen3.8-flash

# ── 🏠  LOCAL LLM 池（local-llm-adapter 装载）—— **唯一必配** ─────
# 用途：主对话 LOCAL 路径 + 意图分类 + prompt-guard 模型检测 + 降级兜底。
# §7.100 隐私不变式（用户仲裁）：分类/guard 检测**只用本地模型**，
# 绝不借用宿主云模型；LOCAL 池未配置时自动降级到关键词/正则规则档。
# 走本地 LAN Qwen3.5-9B server(§7.85, 2026-09-18)
# 实际路径 `/data/lizhouyang/models/mtp/Qwen3.5-9B-Q4_K_M.gguf` —— 无 auth,
# adapter 读不到真 key 时不影响调用(server 忽略空 Bearer)。
# 历史: 192.168.1.174:8911 minicpm5-2b → 67.0.0.5:28001 qwen3.5-9b。
LOCAL_LLM_BASEURL=http://67.0.0.5:28001/v1
LOCAL_LLM_MODEL=qwen3.5-9b
LOCAL_LLM_KEY_ENV=NO_AUTH
LOCAL_LLM_STRIP_TOOLS=false
# §7.87.5(2026-09-19): 关掉 thinking-model(qwen3.5/QwQ/DeepSeek-R1)
# 的 chain-of-thought;false 是 production 推荐值。
LOCAL_LLM_ENABLE_THINKING=false

# ============================================================
# §2. Stage → 池选择指针（§7.100：可留空）
# ============================================================
# 可选值：cloud-llm  /  local-llm  /  （留空=用 plugin Schema 默认 local-llm）
# ★ 隐私不变式（用户仲裁 2026-10-18）：这两个 stage 只应指向本地模型。
#   指向 cloud-llm 会把「待检测的用户原文」送进云池（guard 检测输入 /
#   意图分类输入都是原文，非脱敏后），违背端侧私密定位。默认推荐值即
#   local-llm；无本地端点时留空，intent-router/prompt-guard 会自动
#   fall through 到关键词/正则规则档（见 §7.100）。

# prompt-guard 模型层（Stage 6）—— 只用 local-llm；attack sample 不上行
GUARD_PROVIDER=local-llm

# 意图路由（http-api preflight intent）—— 只用 local-llm；query 原文不上行
INTENT_PROVIDER=local-llm

# ============================================================
# §3. 其他配置（非 LLM）
# ============================================================

# ── prompt-guard 模型层（跟 GUARD_PROVIDER 配套，.env.sh 拼 model） ──
GUARD_MODEL_ENABLED=true
GUARD_MODEL_TIMEOUT_MS=20000
GUARD_MODEL_MAX_INPUT=2000

# ── 意图路由扩展（跟 INTENT_PROVIDER 配套，逗号分隔追加 built-in） ──
INTENT_LLM_TIMEOUT_MS=30000
INTENT_CONFIDENCE_THRESHOLD=0.6
INTENT_MAX_INPUT=2000
INTENT_RECENT_LIMIT=3
INTENT_CLOUD_KEYWORDS=
INTENT_LOCAL_ENTITIES=
INTENT_FALLBACK_KEYWORDS=

# ── §7.92.3 jev 意图识别（toggle,默认 OFF;开 → 在 LLM classifier 之前先跑） ──
# 详见 docs/PROGRESS.md §7.92.3 + ~/work/jev-branch/docs/api_reference.md
# Toggle=false 时 classify() 完全跳过 jev 路径（无 network call）。
# Toggle=true 后：高置信 (>=0.85) + 低风险 (<0.7) → 直接采纳；
#                低置信 / fallback_llm / 闲聊 / transport 失败 → fall through 到 LLM。
# 意图分类 spec（描述 + jev 意图列表）从 config/privacy-policy.json#categories 读，
# 运维人员改 JSON 文件即可，热加载通过 privacy-policy 服务自动 pick up。
# §7.92.7 (2026-09-24): 默认 ON（之前 OFF）。boot probe + 周期 probe 让
# jev-down 时 fast-fail（无 7500ms wall-clock 惩罚），无后顾之忧。如果跑 dsh
# 但不跑 jev 容器，设 INTENT_JEV_ENABLED=false。
INTENT_JEV_ENABLED=true
INTENT_JEV_URL=http://127.0.0.1:8001
INTENT_JEV_TIMEOUT_MS=2500
INTENT_JEV_CONFIDENCE_THRESHOLD=0.85
INTENT_JEV_RISK_THRESHOLD=0.7
# §7.92.6 (2026-09-24): circuit-breaker TTL (ms). When all 3 jev
# batches fail in one classify() call, subsequent calls skip jev
# entirely for this many ms (avoid 3×2500ms=7500ms wasted wall-clock
# when jev is down). Any successful batch closes the breaker. Default
# 30s gives jev time to recover; tune up for known-flaky backends.
INTENT_JEV_BREAKER_TTL_MS=30000
# §7.92.7 (2026-09-24): boot probe + 周期 recovery probe.
# bootProbeEnabled=false 时跳过启动 /health 检测（首次 classify 仍付 3×timeoutMs）。
INTENT_JEV_BOOT_PROBE_ENABLED=true
INTENT_JEV_BOOT_PROBE_TIMEOUT_MS=2000
# breaker 开着期间每 N ms ping /health,2xx 即关闭 breaker（不必等 jevBreakerTtlMs 到期）。
INTENT_JEV_BREAKER_PROBE_MS=5000
INTENT_JEV_PROBE_TIMEOUT_MS=1000

# ── §7.93.1(2026-09-25 通用化)function-call-external prefill ──
# ExternalToolCaller 由外部启动维护（current: cactus-needle 3.0.1 在 needle-http
# **:8081**，契约 GET /health + POST /extract {query,tools,system?,max_new_tokens?}；
# agent stateless=True **无需 /reset**；playground 是外部 webui，本项目不走）。
# 服务端**只实现意图/工具调用提取，不做翻译**（user 仲裁 v2，2026-09-24）；
# P1 中文数字归一化服务端内置（query 含 CJK 自动触发，cn_grounding.py）。
# 本项目 **纯 client**：只参考 caller 实现/契约，不修改它、不管其部署。
# 后续替换 = 写新 caller implements ExternalToolCaller + 改 apply() 一行。
# Phase 5 末 user 终裁"管什么语种 caller 直接用"—— 原文 query 直入 /extract，
# 工具名/参数 走英文 schema。
# 链路：原文 query → POST /extract → function_calls → dsh 执行 tool
#   （realm/PII/audit 不绕过）→ 整段对话给 LOCAL LLM 输出最终回复。
# CLOUD intent 不走 caller；caller 不可达/低置信 fall through 到现有 LLM 自提取。
FUNCTION_CALL_EXTERNAL_ENABLED=false
FUNCTION_CALL_EXTERNAL_URL=http://127.0.0.1:8081
# §7.93 Phase 9 amend (2026-09-25,user 终裁 "4-7s 就是这么慢"):
# 1500→7000ms 让 Path A 能实际触发(needle LAN 当前引擎实测 4-7s/dry-run
# #1 标 376-548ms 是 spec 理想值,实际 25-30x degradation);后续 needle 引擎
# 恢复 < 1s 时再调低。
FUNCTION_CALL_EXTERNAL_TIMEOUT_MS=15000
# 同样:0.7 太严(实测 needle 报 confidence 0.5-0.7 区间),0.5 让多数有
# tool match 的提取通过 adopt gate;后续 needle 模型升级再调高。
FUNCTION_CALL_EXTERNAL_CONFIDENCE_THRESHOLD=0.5
# circuit breaker + boot/periodic probe（§7.92.6/§7.92.7 同模板,Phase 6）
FUNCTION_CALL_EXTERNAL_BREAKER_TTL_MS=30000
FUNCTION_CALL_EXTERNAL_BOOT_PROBE_ENABLED=true
FUNCTION_CALL_EXTERNAL_BOOT_PROBE_TIMEOUT_MS=2000
FUNCTION_CALL_EXTERNAL_BREAKER_PROBE_MS=5000
FUNCTION_CALL_EXTERNAL_PROBE_TIMEOUT_MS=1000

# ── Input-Guard / Privacy-Policy / Realm-Bridge ──────────────────────
INPUT_GUARD_ENABLED=true
REJECT_POLICY_ENABLED=true
SANITIZE_DOWNGRADE_ENABLED=true
REALM_HOT_RELOAD=true
REALM_WATCH_MS=5000

# ── Agent persona（host dsh-persona，含单引号 → 双引号包） ──
PERSONA="You are edge-agent, a privacy-first AI assistant running on the user's device."

# ── local-tools 写权限白名单 ────────────────────────────────────────
LOCAL_TOOLS_WRITABLE=true
LOCAL_TOOLS_ALLOWLIST=/tmp,/home/etsme/cy/agent/dsh-edge-agent

# ── 权限模式 ────────────────────────────────────────────────────────
PERMISSION_MODE=workspace-write

# ── Audit / Ops Log ─────────────────────────────────────────────────
AUDIT_MIN_LEVEL=info
AUDIT_FLUSH_MS=1000
LOG_LEVEL=info
LOG_MAX_AGE_DAYS=1
LOG_MAX_ROTATED=7

# ── Session / Sanitizer 资源限制 ─────────────────────────────────────
MAX_SESSIONS=100
MAX_BODY_BYTES=1048576
SESSION_IDLE_MS=1800000
SAN_MAX_SESSIONS=1000
SAN_SWEEP_MS=60000
SAN_TTL_MS=900000

# ── TEE / Attestation ────────────────────────────────────────────────
TEE_TYPE=simulated

# ── Phase 5 web-search providers (§7.82) ─────────────────────────────
# 三级链: Tavily → 博查 AI → DeepSeek。任一可用即可,任一失败自动 fallback。
# 与其他 secret 同地管理(裸名,§7.75 约定 —— 避开 DSH 黑名单 DSH_/XDG_/
# DYLD_/BASH_FUNC_;dsh-app-boot/lib/index.js:933-1015 拒绝 .env 设这些前缀)。
# 启用任一即激活对应 tier;不写就跳过该 tier,落下一档。
# Tavily: https://tavily.com 注册 → 控制台 → API Keys(以 tvly- 开头)
TAVILY_API_KEY=tvly-PLACEHOLDER_REPLACE_ME
# 博查 AI: https://bocha.cn 控制台 → 创建 API key(以 sk- 开头)
BOCHA_API_KEY=sk-PLACEHOLDER_REPLACE_ME
# Tier-3 DeepSeek fallback:沿用上方 DEEPSEEK_API_KEY,无需另配。
