    "C2_parse_rate": 0.90,
    "C3_bleu": 0.25,
    "C3_completion": 0.85,
    "C4_schema": 0.90,
    "C4_value": 0.70,
    "C5_recall": 0.80,
    "C6_acc": 0.75,
    "C7_pass": 0.67,
    "C8_pass": 0.67,
    "C9_pass": 0.67,
    "C10_retention": 0.70,
    "overall_pass": 70
