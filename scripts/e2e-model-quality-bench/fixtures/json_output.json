{
  "category": "C4 JSON Structured Output",
  "description": "§7.87.4(2026-09-19)精简 10→5 cases — schema conformance + value_fuzzy_match 抽 5 类典型(extract / classify / tool_call / list / sentiment)。",
  "cases": [
    {
      "schema": {
        "type": "object",
        "properties": {"name": {"type": "string"}, "age": {"type": "number"}, "city": {"type": "string"}},
        "required": ["name", "age", "city"]
      },
      "query": "Extract: 张三今年28岁,住在上海",
      "expected": {"name": "张三", "age": 28, "city": "上海"}
    },
    {
      "schema": {
        "type": "object",
        "properties": {"phone": {"type": "string"}, "email": {"type": "string"}, "id_card": {"type": "string"}},
        "required": ["phone", "email", "id_card"]
      },
      "query": "Extract PII: 电话 13800138000,邮箱 test@example.com,身份证 110101199003078811",
      "expected": {"phone": "13800138000", "email": "test@example.com", "id_card": "110101199003078811"}
    },
    {
      "schema": {
        "type": "object",
        "properties": {"category": {"type": "string"}, "confidence": {"type": "number"}},
        "required": ["category", "confidence"]
      },
      "query": "Classify intent (LOCAL/CLOUD) for: 查询本机的IP地址",
      "expected": {"category": "LOCAL", "confidence": 1.0}
    },
    {
      "schema": {
        "type": "object",
        "properties": {"tool": {"type": "string"}, "args": {"type": "object"}},
        "required": ["tool", "args"]
      },
      "query": "帮我查看磁盘使用情况",
      "expected": {"tool": "bash", "args": {"command": "df -h"}}
    },
    {
      "schema": {
        "type": "object",
        "properties": {"result": {"type": "string"}, "confidence": {"type": "number"}},
        "required": ["result", "confidence"]
      },
      "query": "Evaluate sentiment (positive/negative/neutral) for: 这本书太精彩了,强烈推荐!",
      "expected": {"result": "positive", "confidence": 0.95}
    }
  ]
}