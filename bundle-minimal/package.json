{
  "name": "@deepseek-harness-edge-agent/dsh-edge-agent-minimal",
  "version": "0.1.0",
  "private": true,
  "description": "§7.59 最小 bundle 实证载体:与全量包同 lib(部署时 rsync)。派工单单源=cordis.patch.yml(9 插件实装图,名字即 loader 指针名,部署=逐字 cp 零改名);headless 冒烟图由 rig deploy 时剥 file-logger 行块运行时派生,派生物不落仓库。嵌套包内副本与 lib/ 均不入库。(§7.59.4 证伪阶梯退役、§7.59.5 两单合一,boot 签名存档 docs/PROGRESS.md)",
  "type": "module",
  "main": "lib/types/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/types/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./audit-log": {
      "types": "./lib/types/dsh-adapter/audit-log.d.ts",
      "import": "./lib/types/dsh-adapter/audit-log.js"
    },
    "./privacy-policy": {
      "types": "./lib/types/dsh-adapter/privacy-policy.d.ts",
      "import": "./lib/types/dsh-adapter/privacy-policy.js"
    },
    "./prompt-guard": {
      "types": "./lib/types/dsh-adapter/prompt-guard.d.ts",
      "import": "./lib/types/dsh-adapter/prompt-guard.js"
    },
    "./intent-router": {
      "types": "./lib/types/dsh-adapter/intent-router.d.ts",
      "import": "./lib/types/dsh-adapter/intent-router.js"
    },
    "./sanitizer-pipeline": {
      "types": "./lib/types/dsh-adapter/sanitizer-pipeline.d.ts",
      "import": "./lib/types/dsh-adapter/sanitizer-pipeline.js"
    },
    "./realm-skill-bridge": {
      "types": "./lib/types/dsh-adapter/realm-skill-bridge.d.ts",
      "import": "./lib/types/dsh-adapter/realm-skill-bridge.js"
    },
    "./input-guard": {
      "types": "./lib/types/dsh-adapter/input-guard.d.ts",
      "import": "./lib/types/dsh-adapter/input-guard.js"
    },
    "./tools": {
      "types": "./lib/types/dsh-adapter/tools.d.ts",
      "import": "./lib/types/dsh-adapter/tools.js"
    },
    "./file-logger": {
      "types": "./lib/types/dsh-adapter/file-logger.d.ts",
      "import": "./lib/types/dsh-adapter/file-logger.js"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
